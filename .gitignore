# 1. DEPENDENCIES (Heavy folders generated by npm)
node_modules/

# 2. DATABASES & LOCAL DATA (Keep student data private and avoid overwrite conflicts)
*.db
*.sqlite
*.sqlite3
petition.db

# 3. ENVIRONMENT & SECRETS (Never upload passwords or API keys)
.env
.env.local
.env.production

# 4. OPERATING SYSTEM & LOG FILES (Junk files created by Windows/Mac)
.DS_Store
Thumbs.db
npm-debug.log*
